{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/obj/${presetName}"
    },
    {
      "name": "mingw-debug",
      "displayName": "MinGW GCC Debug",
      "inherits": "base",
      "generator": "MinGW Makefiles",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "C:/mingw64/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "C:/mingw64/bin/g++.exe"
      }
    },
    {
      "name": "mingw-release",
      "displayName": "MinGW GCC Release",
      "inherits": "mingw-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "msvc-2026-debug",
      "displayName": "MSVC 2026 Debug (default MSVC)",
      "inherits": "base",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "msvc-2026-release",
      "displayName": "MSVC 2026 Release",
      "inherits": "msvc-2026-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "msvc-2022-debug",
      "displayName": "MSVC 2022 Debug (fallback)",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "msvc-2022-release",
      "displayName": "MSVC 2022 Release",
      "inherits": "msvc-2022-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "linux-gcc-debug",
      "displayName": "Linux GCC Debug",
      "inherits": "base",
      "generator": "Unix Makefiles",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "linux-gcc-release",
      "displayName": "Linux GCC Release",
      "inherits": "linux-gcc-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "mingw-debug", "configurePreset": "mingw-debug", "jobs": 16 },
    { "name": "mingw-release", "configurePreset": "mingw-release", "jobs": 16 },
    { "name": "msvc-2026-debug", "configurePreset": "msvc-2026-debug", "configuration": "Debug", "jobs": 16 },
    { "name": "msvc-2026-release", "configurePreset": "msvc-2026-release", "configuration": "Release", "jobs": 16 },
    { "name": "msvc-2022-debug", "configurePreset": "msvc-2022-debug", "configuration": "Debug", "jobs": 16 },
    { "name": "msvc-2022-release", "configurePreset": "msvc-2022-release", "configuration": "Release", "jobs": 16 },
    { "name": "linux-gcc-debug", "configurePreset": "linux-gcc-debug", "jobs": 16 },
    { "name": "linux-gcc-release", "configurePreset": "linux-gcc-release", "jobs": 16 }
  ]
}

